{
    "maikeconfig": {
        "dir_compiler": {
            "config": {},
            "recipe": "make_directory.py",
            "use_get_tags": 0
        },
        "source_file_info_loaders": {
            "app": {
                "compiler": {
                    "config": {
                    },
                    "recipe": "cxx_linker.py",
                    "use_get_tags": 0
                },
                "config": {},
                "loader": "maikerule"
            },
            "lib": {
                "compiler": {
                    "config": {},
                    "recipe": "make_lib.py",
                    "use_get_tags": 0
                },
                "config": {},
                "loader": "lib"
            },
            "cxx": {
                "compiler": {
                    "config": {
                        "actions":["compile", "sanitize"],
                        "cflags": [
                            "-I.",
                            "-Wall",
                            "-Wextra",
                            "-Werror",
                            "-Wconversion",
                            "-Wsign-conversion",
                            "-Wno-maybe-uninitialized",
                            "-Wno-error=maybe-uninitialized"
                        ],
                        "iquote": [
                          "."
                        ],
                        "std_revision": {
                          "min":"c++23"
                        }
                    },
                    "recipe": "cxx_compiler.py",
                    "use_get_tags": 0
                },
                "config": {},
                "loader": "cxx_src_loader"
            },
            "cxx_test": {
                "compiler": {
                    "config": {
                    "actions":["link", "run"],
                        "cflags": [
                            "-I.",
                            "-Wall",
                            "-Wextra",
                            "-Werror",
                            "-Wconversion",
                            "-Wsign-conversion",
                            "-Wno-maybe-uninitialized",
                            "-Wno-error=maybe-uninitialized"
                        ],
                        "iquote": [
                          "."
                        ],
                        "std_revision": {
                          "min":"c++23"
                        }
                    },
                    "recipe": "cxx_compiler.py",
                    "use_get_tags": 0
                },
                "config": {},
                "loader": "cxx_src_loader"
            },
            "extension": {
                "compiler": {
                    "config": {},
                    "recipe": "",
                    "use_get_tags": 0
                },
                "config": {},
                "loader": "extension"
            },
            "generic_example": {
                "compiler": {
                    "config": {},
                    "recipe": "",
                    "use_get_tags": 0
                },
                "config": {
                    "filename_ext_replacement_mode": "append",
                    "target_filename_ext": ""
                },
                "loader": "generic"
            }
        },
        "source_tree_loader": {
            "file_info_loaders": {
                ".app.maikerule": "app",
                ".lib.maikerule": "lib",
                ".cpp": "cxx",
                ".hpp": "cxx",
                ".py": "extension",
                ".test.cpp": "cxx_test"
            },
            "input_filter": [
                "^\\.",
                "^__"
            ],
            "fullpath_input_filter": [
                "^\\.",
                "^__",
                "experiments",
                "pcg-cpp"
            ],
            "recursive": 1
        }
    }
}
